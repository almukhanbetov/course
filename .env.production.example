# Production environment template — Stage 28A1 design artifact.
#
# This is NOT consumed by any workflow yet (no deploy.yml exists as of this
# session — see STAGE28_PROGRESS.md). It documents the exact shape the real
# production .env on the VPS is expected to have, mirroring .env.example's
# structure so the two stay easy to diff against each other.
#
# Every value below is a placeholder. None of them are real secrets, and
# none of them should ever be committed with real values — the actual
# production .env lives only on the VPS filesystem (or is generated there
# at deploy time from GitHub Environment secrets); see STAGE28_PROGRESS.md's
# "Required GitHub secrets" table for where each real value should come from.

# PostgreSQL
POSTGRES_USER=__SET_VIA_GITHUB_SECRET_PROD_POSTGRES_USER__
POSTGRES_PASSWORD=__SET_VIA_GITHUB_SECRET_PROD_POSTGRES_PASSWORD__
POSTGRES_DB=lms_production
# Not published to the host at all in production — only reachable from
# other containers on the compose network. See STAGE28_PROGRESS.md's
# "production compose strategy" section.
POSTGRES_PORT=5432

# Backend (Go Gin)
BACKEND_PORT=8080
DATABASE_URL=postgres://__POSTGRES_USER__:__POSTGRES_PASSWORD__@postgres:5432/lms_production?sslmode=disable
JWT_SECRET=__SET_VIA_GITHUB_SECRET_PROD_JWT_SECRET__
# Real provider TBD — only "mock" exists in code today (see
# internal/config/config.go's own comment: "there is no real provider wired
# up yet"). Flagged as an open product/infra decision in STAGE28_PROGRESS.md,
# not resolved by this session.
PAYMENT_PROVIDER=__REAL_PROVIDER_NOT_YET_INTEGRATED__

# Frontend (Next.js) — real public domain values, not secrets (safe as
# GitHub Actions `vars`, not `secrets`)
#
# NEXT_PUBLIC_API_URL below matters twice, in two different places, per
# Stage 28A4's investigation:
#  1. Baked into the frontend image's CLIENT bundle at *build* time, by
#     image-publish.yml's own build-arg — sourced from the GitHub Actions
#     repository variable `PROD_NEXT_PUBLIC_API_URL`, NOT from this file.
#     Changing this line alone does nothing to an already-built image;
#     that variable must be updated and the image rebuilt/republished.
#  2. Read live by any server-side (Server Component) code that touches
#     process.env.NEXT_PUBLIC_API_URL — that path DOES read this file's
#     runtime value on the VPS. Keep both in sync.
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=https://compserv.cloud/api
API_INTERNAL_URL=http://backend:8080

# Object storage (MinIO or a real S3-compatible provider)
MINIO_ROOT_USER=__SET_VIA_GITHUB_SECRET_PROD_MINIO_ROOT_USER__
MINIO_ROOT_PASSWORD=__SET_VIA_GITHUB_SECRET_PROD_MINIO_ROOT_PASSWORD__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
# NOT YET FUNCTIONAL as written: Stage 28A4's Nginx design only proxies
# `/` and `/api/` (per its exact, explicit scope) — nothing proxies
# `/storage`, and MinIO is deliberately not given any public port at all
# (docker-compose.prod.yml's `ports: !reset []`). A presigned URL built
# from this value would point at a path Nginx doesn't route anywhere.
# Left as a known, flagged gap for a future session — video playback via
# presigned MinIO URLs will not work in production until it's resolved,
# either by adding a proxied path here or switching to a real S3 provider
# with its own public endpoint. See STAGE28_PROGRESS.md.
S3_PUBLIC_ENDPOINT=https://compserv.cloud/storage
S3_ACCESS_KEY=__SAME_AS_MINIO_ROOT_USER__
S3_SECRET_KEY=__SAME_AS_MINIO_ROOT_PASSWORD__
S3_BUCKET=lms-videos
S3_REGION=us-east-1
VIDEO_MAX_UPLOAD_MB=500
VIDEO_SIGNED_URL_TTL=300
ASSIGNMENT_MAX_UPLOAD_MB=20

# HLS transcoding (video-worker) — safe non-secret defaults, same as dev
HLS_SEGMENT_DURATION=6
VIDEO_JOB_MAX_ATTEMPTS=3
VIDEO_JOB_POLL_INTERVAL_SEC=3
VIDEO_JOB_RETRY_BACKOFF_SEC=30

# Email — Mailpit is dev-only (nothing it "sends" ever leaves the
# container). Production needs a REAL SMTP provider; which one is an open
# decision, not resolved by this session. See STAGE28_PROGRESS.md.
SMTP_HOST=__SET_VIA_GITHUB_SECRET_PROD_SMTP_HOST__
SMTP_PORT=__SET_VIA_GITHUB_SECRET_PROD_SMTP_PORT__
SMTP_USER=__SET_VIA_GITHUB_SECRET_PROD_SMTP_USER__
SMTP_PASSWORD=__SET_VIA_GITHUB_SECRET_PROD_SMTP_PASSWORD__
SMTP_FROM_EMAIL=__SET_VIA_GITHUB_SECRET_PROD_SMTP_FROM_EMAIL__
SMTP_FROM_NAME=LMS Platform

# Notifications (notification-worker) — safe non-secret defaults, same as dev
NOTIFICATION_JOB_MAX_ATTEMPTS=3
NOTIFICATION_JOB_POLL_INTERVAL_SEC=3
NOTIFICATION_JOB_RETRY_BACKOFF_SEC=30
SUBSCRIPTION_EXPIRY_WARNING_DAYS=3
NOTIFICATION_SCAN_INTERVAL=60

# Coding practice / code-runner — safe non-secret defaults, same as dev
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_MB=128
CODE_RUNNER_MAX_OUTPUT_KB=64
CODE_RUNNER_JOB_MAX_ATTEMPTS=2
CODE_RUNNER_JOB_POLL_INTERVAL_SEC=2
CODE_RUNNER_JOB_RETRY_BACKOFF_SEC=10
CODE_RUNNER_MAX_SUBMISSIONS_PER_MINUTE=15
CODE_RUNNER_MAX_CONCURRENT_PER_USER=3

# Auth rate limiting — safe non-secret defaults, same as dev
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SEC=300
JWT_ACCESS_TOKEN_TTL_MINUTES=1440

# Image tag — populated by the (not-yet-created) deploy workflow with the
# git commit SHA being deployed, e.g. sha-a1b2c3d. Never "latest" in the
# actual running .env — see STAGE28_PROGRESS.md's rollback design for why.
IMAGE_TAG=__SET_BY_DEPLOY_WORKFLOW__
IMAGE_REGISTRY=ghcr.io/almukhanbetov

# Stage 30A1 — production PostgreSQL backup (deploy/backup/run-backup.sh,
# triggered by .github/workflows/backup.yml). Encrypts every pg_dump before
# it ever leaves the VPS — generate a real one with e.g.
# `openssl rand -base64 48`, same as every other production secret's own
# comment in this file recommends. Set once, by hand, directly on the VPS —
# never committed, never transmitted through GitHub Actions (the backup
# workflow only ever SSHes in and runs the script; this value is read from
# the VPS's own .env at that point, exactly like POSTGRES_PASSWORD/
# JWT_SECRET/MINIO_ROOT_PASSWORD already are). Losing this passphrase means
# every backup encrypted with it becomes permanently unrestorable — store
# it somewhere durable outside the VPS too (a password manager, not just
# this file), the same way you would for any other credential whose only
# copy living on the VPS itself would be a single point of failure.
BACKUP_ENCRYPTION_PASSPHRASE=__SET_VIA_VPS_ENV_ONLY_NEVER_COMMITTED__
