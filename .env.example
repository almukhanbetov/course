# PostgreSQL
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms
POSTGRES_PORT=5432

# Backend (Go Gin)
BACKEND_PORT=8080
DATABASE_URL=postgres://lms:lms_password@postgres:5432/lms?sslmode=disable
# Generate a real secret per environment, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-per-environment
# "mock" enables the development-only payment simulator and the
# POST /api/v1/payments/:id/mock-confirm endpoint. Any other value disables
# that endpoint entirely (404) — there is no real provider wired up yet.
PAYMENT_PROVIDER=mock

# Read only by cmd/bootstrap-admin (run automatically by the admin-bootstrap
# compose service, after migrate) — creates this admin account ONLY if no
# active admin exists yet, so this is safe to leave set permanently in dev.
# These are the same email/password every prior dev seed used, kept here so
# local login is unchanged: admin@example.com / ChangeMe123!. Never used as
# a fallback/default by the application itself — see .env.production.example
# for why production must set real values here instead.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Frontend (Next.js)
FRONTEND_PORT=3001
# Used by the browser (client components)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Used by the Next.js server (Server Components) inside the Docker network
API_INTERNAL_URL=http://backend:8080

# Object storage (MinIO, S3-compatible) — lesson video files
MINIO_ROOT_USER=lms-minio-admin
# Generate a real secret per environment, e.g.: openssl rand -base64 24
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret-per-environment
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3_ENDPOINT: used by the backend for Put/Delete/HeadBucket, reachable only
# inside the Docker network.
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT: used only to presign GET URLs — these are handed to
# the student's browser, so they must resolve from outside the Docker
# network (mirrors NEXT_PUBLIC_API_URL vs API_INTERNAL_URL above).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Dev convenience: reuse the MinIO root credentials above as the S3
# access/secret key (must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD). Use a
# dedicated least-privilege user/policy in any shared environment.
S3_ACCESS_KEY=lms-minio-admin
S3_SECRET_KEY=replace-with-a-long-random-secret-per-environment
S3_BUCKET=lms-videos
S3_REGION=us-east-1
# Max accepted lesson video upload size, in megabytes.
VIDEO_MAX_UPLOAD_MB=500
# How long a signed lesson-video URL stays valid, in seconds (legacy Stage
# 10 MP4-only videos only — HLS playback goes through the backend-authorized
# stream proxy instead and isn't time-limited the same way).
VIDEO_SIGNED_URL_TTL=300
# Max accepted homework submission file size, in megabytes (PDF/TXT/ZIP/PNG/JPEG).
ASSIGNMENT_MAX_UPLOAD_MB=20

# HLS transcoding (video-worker)
# Target segment length. GOP/keyframe interval is locked to this * fps so
# every segment boundary lands on a keyframe.
HLS_SEGMENT_DURATION=6
# A job is marked permanently "failed" after this many attempts.
VIDEO_JOB_MAX_ATTEMPTS=3
# How often video-worker polls video_jobs when the queue is empty.
VIDEO_JOB_POLL_INTERVAL_SEC=3
# Delay before a failed job becomes claimable again for a retry.
VIDEO_JOB_RETRY_BACKOFF_SEC=30

# Email (Mailpit in development — a local SMTP catcher, nothing is ever
# actually delivered). Only notification-worker reads these; the API
# backend never sends email itself, only enqueues jobs.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# Mailpit accepts unauthenticated mail — leave these blank in development.
# A real provider (SES, Postmark, a corporate relay, ...) would need both.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@lms.local
SMTP_FROM_NAME=LMS Platform

# Notifications (notification-worker)
# A job is marked permanently "failed" after this many attempts.
NOTIFICATION_JOB_MAX_ATTEMPTS=3
# How often notification-worker polls notification_jobs when idle.
NOTIFICATION_JOB_POLL_INTERVAL_SEC=3
# Delay before a failed job becomes claimable again for a retry.
NOTIFICATION_JOB_RETRY_BACKOFF_SEC=30
# How many days before expires_at a subscription gets a "expiring soon" notice.
SUBSCRIPTION_EXPIRY_WARNING_DAYS=3
# How often (seconds) the worker scans subscriptions for expiry warnings /
# newly-expired subscriptions. Not a cron baked into the HTTP backend — see
# internal/notifications.Worker.RunExpiryScan.
NOTIFICATION_SCAN_INTERVAL=60

# Coding practice / code-runner (Stage 16). System ceilings — a coding
# exercise's own time_limit_ms/memory_limit_mb may be stricter but never
# looser (see internal/coding/service.go's validateExerciseInput and
# internal/coding/runner.go's Worker.clampLimits).
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_MB=128
# Per-submission captured stdout/compile-output cap.
CODE_RUNNER_MAX_OUTPUT_KB=64
# A job is marked permanently "failed" (submission -> internal_error) after
# this many attempts.
CODE_RUNNER_JOB_MAX_ATTEMPTS=2
# How often cmd/code-runner polls code_execution_jobs when idle.
CODE_RUNNER_JOB_POLL_INTERVAL_SEC=2
# Delay before a failed job becomes claimable again for a retry.
CODE_RUNNER_JOB_RETRY_BACKOFF_SEC=10
# Per-user rate limit, enforced by the API backend (PostgreSQL-backed, not
# just a disabled frontend button).
CODE_RUNNER_MAX_SUBMISSIONS_PER_MINUTE=15
# Per-user cap on submissions simultaneously queued/running — exceeding it
# returns 429 TOO_MANY_EXECUTIONS.
CODE_RUNNER_MAX_CONCURRENT_PER_USER=3
