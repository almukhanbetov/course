FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/notification-worker ./cmd/notification-worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && \
    adduser -D -u 10001 appuser
WORKDIR /app
COPY --from=build --chown=appuser:appuser /out/notification-worker ./notification-worker
USER appuser
ENTRYPOINT ["./notification-worker"]
